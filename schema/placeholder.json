{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hessian.AI Plugin Configuration Schema",
  "description": "Schema for validating pi-hessian.json configuration files generated by the Hessian.AI plugin",
  "type": "object",
  "required": ["provider", "permission"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "permission": {
      "type": "object",
      "description": "Tool permission settings for pi",
      "additionalProperties": {
        "type": "string",
        "enum": ["allow", "ask", "deny"]
      }
    },
    "model": {
      "type": "string",
      "description": "Default model identifier (e.g., 'hessian/tud/mistral-medium-3.5-128b')",
      "pattern": "^hessian/"
    },
    "last_updated": {
      "type": "string",
      "description": "Timestamp of last configuration update",
      "format": "date-time"
    },
    "provider": {
      "type": "object",
      "required": ["hessian"],
      "properties": {
        "hessian": {
          "type": "object",
          "required": ["npm", "name", "options", "models"],
          "properties": {
            "npm": {
              "type": "string",
              "const": "@ai-sdk/openai-compatible"
            },
            "name": {
              "type": "string",
              "description": "Provider display name"
            },
            "options": {
              "type": "object",
              "required": ["baseURL", "apiKey"],
              "properties": {
                "baseURL": {
                  "type": "string",
                  "pattern": "^https?://.+"
                },
                "apiKey": {
                  "type": "string",
                  "pattern": "HESSIAN_API_KEY"
                }
              },
              "additionalProperties": false
            },
            "models": {
              "type": "object",
              "description": "Hessian model configurations",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "category": { "type": "string" },
                  "alias": { "type": "boolean" },
                  "can_reason": { "type": "boolean" },
                  "attachment": { "type": "boolean" },
                  "limit": {
                    "type": "object",
                    "properties": {
                      "context": { "type": "integer", "minimum": 1 },
                      "output": { "type": "integer", "minimum": 1 }
                    }
                  }
                }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
