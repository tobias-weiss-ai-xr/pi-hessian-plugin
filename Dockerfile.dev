# Development Dockerfile for Hessian.AI Plugin
FROM node:24-alpine

# Install development dependencies
RUN apk add --no-cache \
    curl \
    jq \
    bash \
    git \
    bc \
    # Development tools
    python3 \
    py3-pip \
    vim \
    nano \
    # Build tools
    make \
    g++ \
    gcc \
    musl-dev

# Create non-root user (use a UID that doesn't conflict with the node user)
RUN adduser -D -s /bin/bash -u 1001 -G node pluginuser || adduser -D -s /bin/bash -G node pluginuser
WORKDIR /home/pluginuser/app

# Copy all files (including dev dependencies)
COPY . .

# Install all dependencies (including devDependencies)
RUN npm install

# Ensure correct permissions (files are in WORKDIR /home/pluginuser/app)
RUN chmod +x /home/pluginuser/app/src/*.sh /home/pluginuser/app/sandbox/*.sh 2>/dev/null || true

# Set up pi config directory
RUN mkdir -p /home/pluginuser/.config/pi/plugins/hessian
RUN mkdir -p /home/pluginuser/.config/pi/plugins/hessian/schema && \
    mkdir -p /home/pluginuser/.config/pi/plugins/hessian/.opencode && \
    cp -rf /home/pluginuser/app/src/. /home/pluginuser/.config/pi/plugins/hessian/ && \
    cp -f /home/pluginuser/app/schema/placeholder.json /home/pluginuser/.config/pi/plugins/hessian/schema/placeholder.json && \
    cp -rf /home/pluginuser/app/skills /home/pluginuser/.config/pi/plugins/hessian/ && \
    chown -R node:node /home/pluginuser/.config

# Switch to non-root user
USER pluginuser
WORKDIR /home/pluginuser/app

# Environment variables
ENV NODE_ENV=development
ENV HESSIAN_PROFILE="development"

# Default command
CMD ["tail", "-f", "/dev/null"]
